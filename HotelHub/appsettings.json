{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HotelHubDB;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Issuer": "HotelHub.API",
        "Audience": "HotelHub.API.Client",
        "AccessTokenExpirationInMinutes": 45,
        "RefreshTokenExpirationInDays": 7
    },
    "AdminUser": {
        "Email": "admin@hotelhub.com",
        "FirstName": "HotelHub",
        "LastName": "Admin"
    },
    "Email": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "DisplayName": "HotelHub",
        "EnableSsl": true
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Information",
                "System": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext"
        ],
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/hotelhub-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "rollOnFileSizeLimit": true
                }
            }
        ]
    }
}

